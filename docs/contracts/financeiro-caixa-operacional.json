{
  "contract": "financeiro-caixa-operacional",
  "version": 1,
  "captured_at": "2026-09-10",
  "scope": [
    "caixa-sessao-por-unidade",
    "vinculo-automatico-dinheiro-pix",
    "fechamento-server-side",
    "historico-nao-destrutivo",
    "financeiro-saidas-estrutura-minima"
  ],
  "authority": {
    "database": "tenant-postgresql",
    "client_may_supply_closing_totals": false,
    "cash_box_scope": "unidade_id",
    "tenant_id_duplicated_inside_tenant_database": false
  },
  "http": {
    "GET /api/financeiro/caixa/aberto": {
      "permission": "visualizar_financeiro"
    },
    "POST /api/financeiro/caixa/abrir": {
      "permission": "gestao_financeira"
    },
    "POST /api/financeiro/caixa/{id}/fechar": {
      "permission": "gestao_financeira"
    }
  },
  "session": {
    "one_open_per_unit": true,
    "database_constraint": "uq_caixa_sessao_aberta_por_unidade",
    "open_value_must_be_non_negative": true,
    "physical_delete": "blocked",
    "close_is_legitimate_update": true
  },
  "payments": {
    "auto_attach_types": [
      "Dinheiro",
      "PIX"
    ],
    "other_types_auto_attach": false,
    "absence_of_open_session": "payment-remains-valid-with-null-caixa_sessao_id",
    "closed_session_accepts_new_linked_movement": false,
    "reversed_count_in_close": false
  },
  "close": {
    "formula": "valor_abertura + dinheiro + pix - saidas",
    "calculation": "tenant-postgresql-numeric",
    "transaction": true,
    "pessimistic_lock": true,
    "repeat": "409-without-history-rewrite"
  },
  "outputs": {
    "status": "structural-dependency-only",
    "crud_http": false,
    "paid_linked_unreversed_subtracted": true,
    "reversed_subtracted": false,
    "physical_delete": "blocked-use-estorno"
  },
  "invariants": {
    "central_connection_for_financial_domain": false,
    "new_trigger_functions_security": "SECURITY INVOKER",
    "new_trigger_functions_search_path": "empty",
    "schema_qualified_database_references": true
  },
  "sources": {
    "supabase_live": {
      "project": "eramenhnqcbyctyiqwlm",
      "access": "read-only-conformance",
      "objects": [
        "public.caixa_sessoes",
        "public.financeiro_saidas",
        "public.atendimento_pagamentos"
      ]
    },
    "laravel_base": {
      "repository": "DevCactusTecnologia/sislac-api",
      "commit": "dd338a4473a4fff21f83c4696d7864b07af6ec53",
      "branch": "fase-financeiro-totais-atendimento"
    }
  },
  "out_of_scope": [
    "crud-saidas",
    "sangria",
    "suprimento",
    "caixa-por-operador",
    "multiplos-caixas-mesma-unidade",
    "conciliacao",
    "dre",
    "erp",
    "convenios-faturas",
    "resumo-financeiro",
    "frontend-cutover",
    "impressao-ui"
  ]
}
