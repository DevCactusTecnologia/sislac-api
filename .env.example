# =============================================================================
# SISLAC — API · Variáveis de ambiente (exemplo)
# =============================================================================
# Copie para `.env` e edite. NUNCA comite o `.env` — só este `.env.example`.
# =============================================================================

APP_NAME=SISLAC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sislac-api.test
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco CENTRAL: plataforma, usuários, Super Admin e provisionamento.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sislac_central
DB_USERNAME=sislac_app
DB_PASSWORD=change-me-in-env
DB_SSLMODE=prefer

# Credencial administrativa do PostgreSQL usada somente pelo provisionamento.
DB_ROOT_USER=postgres
DB_ROOT_PASSWORD=postgres

# Molde da conexão física de cada laboratório.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=sislac_app
TENANT_DB_PASSWORD=change-me-in-env
TENANT_DB_NAME_PREFIX=sislac_t_

# Cache, sessão, Sanctum e fila usam PostgreSQL nesta fundação.
CACHE_STORE=database
CACHE_PREFIX=sislac
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=sislac.com.br,www.sislac.com.br,sislac.test,sislac-api.test,localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Arquivos. Credenciais S3 só serão usadas quando houver consumidor real.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# E-mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sislac.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API — manter vazio até a onda da integração.
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=

# pgAdmin opcional (`docker compose --profile tools up -d pgadmin`).
PGADMIN_EMAIL=admin@sislac.local
PGADMIN_PASSWORD=admin

# Plataforma.
FRONTEND_URL=https://sislac.com.br
CORS_ALLOWED_ORIGINS=https://sislac.com.br,https://www.sislac.com.br,http://localhost:5173
PDF_SHARE_SECRET=
INTERNAL_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
