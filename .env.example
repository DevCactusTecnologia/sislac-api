# =============================================================================
# SISLAC — API · Variáveis de ambiente (exemplo)
# =============================================================================
# Copie para `.env` e edite. NUNCA comite o `.env` — só este `.env.example`.
# Valores aqui são de DESENVOLVIMENTO. Os de produção ficam no `.env` da VPS
# (ver docs/DEPLOY.md), gerados com `openssl rand -base64 32`.
# =============================================================================

APP_NAME=SISLAC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd usa o nome da pasta do projeto: http://<pasta>.test
APP_URL=http://sislac-api.test
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco CENTRAL (tenants, usuários e vínculos, planos, provisionamento)
# Dentro do Docker Compose o host vira `postgres` automaticamente.
# -----------------------------------------------------------------------------
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sislac_central
DB_USERNAME=sislac_app
DB_PASSWORD=change-me-in-env
DB_SSLMODE=prefer

# Superusuário do Postgres — usado SÓ pelo pipeline de provisionamento para
# criar/apagar bancos de laboratório. Nunca por requisições normais.
DB_ROOT_USER=postgres
DB_ROOT_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Conexão de TENANT (molde: o nome do banco é definido em runtime, Fase 1)
# -----------------------------------------------------------------------------
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=sislac_app
TENANT_DB_PASSWORD=change-me-in-env
TENANT_DB_NAME_PREFIX=sislac_t_

# -----------------------------------------------------------------------------
# Cache, sessão e filas
# Dev: `database` (não exige Redis rodando). Produção: `redis` (docs/DEPLOY.md).
# -----------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=sislac
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_DB=0
HORIZON_PREFIX=sislac_horizon:

# -----------------------------------------------------------------------------
# Arquivos (Fase 2: laudos, comprovantes e assinaturas → S3-compatível)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# WebSockets (Fase 2 — Reverb)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
REVERB_APP_ID=sislac
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sislac.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Fase 2 — Meta, oficial)
# -----------------------------------------------------------------------------
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# pgAdmin (docker compose; em produção só via túnel SSH — docs/PGADMIN.md)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@sislac.local
PGADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Plataforma
# -----------------------------------------------------------------------------
# Endereço do front (todos os laboratórios usam o mesmo — sem subdomínio)
FRONTEND_URL=https://sislac.com.br
# Origens permitidas no CORS, separadas por vírgula
CORS_ALLOWED_ORIGINS=https://sislac.com.br,http://localhost:5173
# Chave que assina links públicos de PDF (rotacione periodicamente)
PDF_SHARE_SECRET=
# Segredo de webhooks internos
INTERNAL_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
