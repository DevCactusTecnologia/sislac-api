# =============================================================================
# SISLAC — API · Variáveis de ambiente (exemplo)
# =============================================================================
# Copie para `.env` e edite. NUNCA comite o `.env` — só este `.env.example`.
# =============================================================================

APP_NAME=SISLAC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sislac-api.test
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco CENTRAL: plataforma, usuários, Super Admin e provisionamento.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sislac_central
DB_USERNAME=sislac_app
DB_PASSWORD=change-me-in-env
DB_SSLMODE=prefer

# Credencial administrativa do PostgreSQL usada somente pelo provisionamento.
DB_ROOT_USER=postgres
DB_ROOT_PASSWORD=postgres

# Molde da conexão física de cada laboratório.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=sislac_app
TENANT_DB_PASSWORD=change-me-in-env

# Supabase Auth — fonte de autenticação clínica durante a transição.
# Use somente URL pública do projeto e publishable key; nunca service_role/secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Origem PostgreSQL Supabase — somente leitura/concordância durante a transição.
# O projeto atual já possui supabase_read_only_user; use sua credencial própria.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=supabase_read_only_user
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Opcional para sslmode=verify-full.
SUPABASE_DB_SSLROOTCERT=

# Cache e sessão usam PostgreSQL. Fila fica síncrona enquanto não houver consumidor runtime.
CACHE_STORE=database
CACHE_PREFIX=sislac
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# E-mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sislac.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# pgAdmin opcional (`docker compose --profile tools up -d pgadmin`).
PGADMIN_EMAIL=admin@sislac.local
PGADMIN_PASSWORD=admin

# Plataforma.
FRONTEND_URL=https://sislac.com.br
CORS_ALLOWED_ORIGINS=https://sislac.com.br,https://www.sislac.com.br,http://localhost:5173
